# --- Database (Neon) -------------------------------------------------------
# Use the POOLED connection string from the Neon console (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/duro?sslmode=require"

# --- Busha -----------------------------------------------------------------
# MOCK = deterministic stateful sandbox (persisted in Neon), LIVE = real Busha sandbox.
# Can be overridden per request with the `x-busha-mode` header.
BUSHA_API_MODE="MOCK"
BUSHA_BASE_URL="https://api.sandbox.busha.so"
BUSHA_BEARER_TOKEN=""
# HMAC-SHA256 secret used to sign/verify `x-bu-signature` on /api/webhooks/busha
BUSHA_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# --- Duro tunables (optional) ----------------------------------------------
# NGN per 1 USD used by the MOCK sandbox for cNGN <-> USDC quotes.
DURO_USD_NGN_RATE="1593"
# Milliseconds per payout timeline stage in MOCK mode.
DURO_PAYOUT_STAGE_MS="2000"
